[user]
  name = Koen Verburg
  email = 10489237+koenverburg@users.noreply.github.com

[core]
  editor = vim

[push]
  default = current

[pull]
  default = current

[diff]
  renameLimit = 999999

[interactive]
  diffFilter = delta --color-only --features=interactive

[commit]
  gpgsign = false

[merge "mergiraf"]
  name = mergiraf
  driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

[alias]
  # pretty log
  plog = log --color --graph --pretty=format:'%Cred%h%Creset %Cgreen(%cr) %C(bold blue)<%an>%Creset -%C(yellow)%d%Creset %s' --abbrev-commit --

[init]
	defaultBranch = main
